RUN_ENV=development
PICO_API_TOKEN=dev
PICO_RUNTIME=stub
PICO_IDLE_TIMEOUT_SECS=300
PICO_WORKSPACE_ROOT=/tmp/pico-workspaces

PICO_GUEST_AGENT_ADDR=127.0.0.1:9999
PICO_ROOTFS_PATH=$HOME/.local/share/pico/assets/rootfs.ext4

PICO_FIRECRACKER_BIN=firecracker
PICO_FIRECRACKER_SOCKET_DIR=/tmp

PICO_QEMU_MODE=development
PICO_QEMU_BIN=qemu-system-aarch64
PICO_QEMU_KERNEL_PATH=$HOME/.local/share/pico/assets/kernel/aarch64/vmlinux
PICO_QEMU_KERNEL_CMDLINE="console=ttyAMA0 reboot=k panic=1 root=/dev/vda rw init=/init nomodules"
PICO_QEMU_ACCEL=hvf:tcg
PICO_QEMU_MEM_MIB=512
PICO_QEMU_VCPUS=1
PICO_QEMU_GUEST_AGENT_PORT=9999
PICO_QEMU_BOOT_TIMEOUT_SECS=30
PICO_QEMU_DISK_SNAPSHOT=true
# Production guest transport (ADR-0003): vsock by default in production mode,
# TCP loopback in development. Set to true on Linux dev to exercise vsock.
PICO_QEMU_ENABLE_VSOCK=false
# Optional explicit guest CID (default: derived from the sandbox id).
# PICO_QEMU_VSOCK_CID=3
PICO_QEMU_VSOCK_PORT=52
# Compatibility fallback only: virtio-serial chardev socket instead of vsock.
# Only honored when PICO_QEMU_ENABLE_VSOCK=false.
PICO_QEMU_SERIAL_FALLBACK=false
